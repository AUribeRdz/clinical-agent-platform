# Copy this file to .env and fill in real values before running docker-compose up

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=clinical
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── API ───────────────────────────────────────────────────────────────────────
# JWT secret — change this to a long random string in any real environment
JWT_SECRET=demo-secret-change-in-production

# Your Anthropic API key — get one at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── HITL confidence thresholds (0.0 to 1.0) ──────────────────────────────────
# Agent outputs below these values are sent to the HITL review queue
CONFIDENCE_THRESHOLD_ADVERSE_EVENT=0.92
CONFIDENCE_THRESHOLD_PROTOCOL_DEV=0.95
CONFIDENCE_THRESHOLD_SITE_NOTE=0.70

# ── Worker ────────────────────────────────────────────────────────────────────
# How often the worker polls the mock EDC (seconds)
POLL_INTERVAL_SECONDS=60

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=development
